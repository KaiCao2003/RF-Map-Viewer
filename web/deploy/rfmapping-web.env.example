# RF datasets and companion files are read only through the viewer API.
RFMAPPING_RF_ROOT=/data/rfmapping

# The figure composer may publish only into an existing directory below this
# root. Dataset sources are never overwritten by a figure export.
RFMAPPING_FIGURE_EXPORT_ROOT=/data/rfmapping

# Cache and user-requested exports live on rfmapping_remote's local SSD, never on the
# shared source mount or inside an immutable release.
RFMAPPING_CACHE_ROOT=/srv/rfmapping/cache
RFMAPPING_OUTPUT_ROOT=/srv/rfmapping/exports
RFMAPPING_CACHE_MAX_BYTES=53687091200

# Browser-session hashes persist outside immutable releases. The shared PI
# answer and auth generation are loaded from the dedicated private gate env.
RFMAPPING_GATE_DB=~/.local/share/lab-access-gates/rfmapping.sqlite3

# Enforced for requests forwarded by the local Nginx reverse proxy.
RFMAPPING_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,fe80::/10,198.51.100.0/24,192.0.2.0/24,203.0.113.0/24
