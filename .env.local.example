# Copy to .env.local, fill in private values, and keep that file untracked.
export RFMAPPING_REMOTE_HOST=rfmapping_remote
export RFMAPPING_DATA_ROOT=/data/rfmapping/recordings
export RFMAPPING_DEPLOY_ROOT=/srv/rfmapping
# Needed only when deliberately operating a deployment:
export RFMAPPING_DEPLOY_USER=rfmapping
export RFMAPPING_DEPLOY_HOSTS=rfmapping_remote
